+
+  namespace {
+    /**
+     * @brief Guard that owns one session-scoped display-sleep inhibitor.
+     *
+     * The inhibitor is acquired over D-Bus and released either explicitly or
+     * when the guard is destroyed. Closing the D-Bus fd releases the inhibitor
+     * even if the desktop session manager lost the reply, so a crashed host
+     * never leaves the user with a permanently blanking display.
+     */
+    class dbus_inhibit_guard_t: public display_awake_guard_t {
+    public:
+      explicit dbus_inhibit_guard_t(gint32 cookie, GDBusConnection *conn, const char *name, const char *path, const char *iface):
+          cookie_(cookie),
+          conn_(conn) {
+        std::strncpy(name_, name, sizeof(name_) - 1);
+        std::strncpy(path_, path, sizeof(path_) - 1);
+        std::strncpy(iface_, iface, sizeof(iface_) - 1);
+      }
+
+      ~dbus_inhibit_guard_t() override {
+        release();
+      }
+
+      dbus_inhibit_guard_t(const dbus_inhibit_guard_t &) = delete;
+      dbus_inhibit_guard_t &operator=(const dbus_inhibit_guard_t &) = delete;
+
+      void release() {
+        if (!conn_ || cookie_ < 0) {
+          return;
+        }
+        g_autoptr(GError) err = nullptr;
+        g_dbus_connection_call_sync(
+          conn_,
+          name_,
+          path_,
+          iface_,
+          "UnInhibit",
+          g_variant_new("(u)", static_cast<guint32>(cookie_)),
+          nullptr,
+          G_DBUS_CALL_FLAGS_NO_AUTO_START,
+          2000,
+          nullptr,
+          &err
+        );
+        if (err) {
+          BOOST_LOG(debug) << "display power: UnInhibit failed: "sv << err->message;
+        }
+        g_object_unref(conn_);
+        conn_ = nullptr;
+        cookie_ = -1;
+      }
+
+    private:
+      gint32 cookie_ = -1;
+      GDBusConnection *conn_ = nullptr;
+      char name_[128] {};
+      char path_[128] {};
+      char iface_[128] {};
+    };
+
+    /**
+     * @brief Call org.freedesktop.ScreenSaver.Inhibit on the session bus.
+     * @return Cookie (>= 0) on success, -1 on failure.
+     */
+    gint32 screensaver_inhibit(GDBusConnection *conn, const std::string &reason) {
+      g_autoptr(GError) err = nullptr;
+      auto reply = g_dbus_connection_call_sync(
+        conn,
+        "org.freedesktop.ScreenSaver",
+        "/org/freedesktop/ScreenSaver",
+        "org.freedesktop.ScreenSaver",
+        "Inhibit",
+        g_variant_new("(ss)", "sunshine", reason.c_str()),
+        G_VARIANT_TYPE("(u)"),
+        G_DBUS_CALL_FLAGS_NO_AUTO_START,
+        2000,
+        nullptr,
+        &err
+      );
+      if (!reply) {
+        BOOST_LOG(debug) << "display power: ScreenSaver Inhibit unavailable: "sv << err->message;
+        return -1;
+      }
+      gint32 cookie = -1;
+      g_variant_get(reply, "(u)", &cookie);
+      g_variant_unref(reply);
+      return cookie;
+    }
+
+    /**
+     * @brief Call org.freedesktop.ScreenSaver.SimulateUserActivity to wake displays.
+     */
+    bool screensaver_wake(GDBusConnection *conn) {
+      g_autoptr(GError) err = nullptr;
+      g_dbus_connection_call_sync(
+        conn,
+        "org.freedesktop.ScreenSaver",
+        "/org/freedesktop/ScreenSaver",
+        "org.freedesktop.ScreenSaver",
+        "SimulateUserActivity",
+        nullptr,
+        nullptr,
+        G_DBUS_CALL_FLAGS_NO_AUTO_START,
+        2000,
+        nullptr,
+        &err
+      );
+      if (err) {
+        BOOST_LOG(debug) << "display power: SimulateUserActivity unavailable: "sv << err->message;
+        return false;
+      }
+      return true;
+    }
+
+    /**
+     * @brief Take a logind delay-mode inhibitor against idling/suspending.
+     *
+     * This covers sessions where no ScreenSaver service exists: the session
+     * manager must delay blanking (and logind must delay suspend) until the
+     * fd is closed. Closing the fd on guard destruction always releases it.
+     * @return fd (>= 0) on success, -1 on failure.
+     */
+    int logind_inhibit(GDBusConnection *conn, const std::string &reason) {
+      g_autoptr(GError) err = nullptr;
+      auto reply = g_dbus_connection_call_sync(
+        conn,
+        "org.freedesktop.login1",
+        "/org/freedesktop/login1",
+        "org.freedesktop.login1.Manager",
+        "Inhibit",
+        g_variant_new("(ssss)", "idle:sleep", "sunshine", reason.c_str(), "delay"),
+        G_VARIANT_TYPE("(h)"),
+        G_DBUS_CALL_FLAGS_NO_AUTO_START,
+        2000,
+        nullptr,
+        &err
+      );
+      if (!reply) {
+        BOOST_LOG(debug) << "display power: logind Inhibit unavailable: "sv << err->message;
+        return -1;
+      }
+      gint32 fd = -1;
+      g_variant_get(reply, "(h)", &fd);
+      g_variant_unref(reply);
+      return fd;
+    }
+
+    /**
+     * @brief Guard for the logind fd-based inhibitor.
+     */
+    class logind_inhibit_guard_t: public display_awake_guard_t {
+    public:
+      explicit logind_inhibit_guard_t(int fd):
+          fd_(fd) {
+      }
+
+      ~logind_inhibit_guard_t() override {
+        if (fd_ >= 0) {
+          ::close(fd_);
+        }
+      }
+
+      logind_inhibit_guard_t(const logind_inhibit_guard_t &) = delete;
+      logind_inhibit_guard_t &operator=(const logind_inhibit_guard_t &) = delete;
+
+    private:
+      int fd_ = -1;
+    };
+
+    /**
+     * @brief Linux display power control over freedesktop D-Bus interfaces.
+     */
+    class linux_display_power_t: public display_power_t {
+    public:
+      bool wake_display(const std::string &display_name) override {
+        // display_name is not needed for session-level wake: SimulateUserActivity
+        // wakes every display of the session, which is what capture needs.
+        g_autoptr(GError) err = nullptr;
+        GDBusConnection *conn = g_bus_get_sync(G_BUS_TYPE_SESSION, nullptr, &err);
+        if (!conn) {
+          BOOST_LOG(debug) << "display power: no session bus for wake: "sv << err->message;
+          return false;
+        }
+        const bool ok = screensaver_wake(conn);
+        g_object_unref(conn);
+        if (ok) {
+          BOOST_LOG(info) << "display power: wake requested for session displays"sv;
+        }
+        return ok;
+      }
+
+      [[nodiscard]] std::unique_ptr<display_awake_guard_t> keep_awake(const std::string &reason) override {
+        g_autoptr(GError) err = nullptr;
+        GDBusConnection *conn = g_bus_get_sync(G_BUS_TYPE_SESSION, nullptr, &err);
+        if (!conn) {
+          BOOST_LOG(debug) << "display power: no session bus: "sv << err->message;
+          return nullptr;
+        }
+
+        // Primary: desktop session manager inhibitor (GNOME/KDE both implement
+        // org.freedesktop.ScreenSaver; it blocks blanking and screen locking).
+        const gint32 cookie = screensaver_inhibit(conn, reason);
+        if (cookie >= 0) {
+          BOOST_LOG(info) << "display power: session inhibitor acquired (cookie "sv << cookie << ")"sv;
+          return std::make_unique<dbus_inhibit_guard_t>(cookie, conn,
+            "org.freedesktop.ScreenSaver", "/org/freedesktop/ScreenSaver", "org.freedesktop.ScreenSaver");
+        }
+
+        // Fallback: logind delay inhibitor keeps blanking/suspend deferred
+        // while streaming even without a session manager service.
+        const int fd = logind_inhibit(conn, reason);
+        g_object_unref(conn);
+        if (fd >= 0) {
+          BOOST_LOG(info) << "display power: logind idle/sleep inhibitor acquired"sv;
+          return std::make_unique<logind_inhibit_guard_t>(fd);
+        }
+
+        BOOST_LOG(warning) << "display power: unable to inhibit display sleep on this session"sv;
+        return nullptr;
+      }
+    };
+  }  // namespace
+
+  std::unique_ptr<display_power_t> display_power() {
+    return std::make_unique<linux_display_power_t>();
+  }
 }  // namespace platf
